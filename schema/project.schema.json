{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automontage.local/schema/project.schema.json",
  "title": "AutoMontage Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "slug", "createdAt", "updatedAt", "source", "transcript", "briefs", "renders", "currentBrief", "latestRender", "final"],
  "properties": {
    "version": {"const": 1},
    "projectKind": {"enum": ["video", "motion-reel"]},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "createdAt": {"type": "string", "minLength": 1},
    "updatedAt": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalPath", "originalLocalPath", "localPath", "revision", "history"],
      "properties": {
        "mediaKind": {"enum": ["video", "audio"]},
        "originalPath": {"type": "string", "minLength": 1},
        "originalLocalPath": {"$ref": "#/definitions/projectPath"},
        "localPath": {"$ref": "#/definitions/projectPath"},
        "revision": {"type": "integer", "minimum": 1},
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "localPath", "editPath", "transcriptPath"],
            "properties": {
              "revision": {"type": "integer", "minimum": 2},
              "localPath": {"$ref": "#/definitions/projectPath"},
              "editPath": {"$ref": "#/definitions/projectPath"},
              "transcriptPath": {"$ref": "#/definitions/projectPath"}
            }
          }
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words", "captions"],
      "properties": {
        "words": {"$ref": "#/definitions/projectPath"},
        "captions": {"$ref": "#/definitions/projectPath"}
      }
    },
    "briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "jsonPath", "markdownPath", "status", "theme", "aspect"],
        "properties": {
          "kind": {"enum": ["lesson", "motion-reel"]},
          "revision": {"type": "integer", "minimum": 1},
          "status": {"enum": ["draft", "approved"]},
          "jsonPath": {"$ref": "#/definitions/projectPath"},
          "markdownPath": {"anyOf": [{"$ref": "#/definitions/projectPath"}, {"type": "null"}]},
          "theme": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "aspect": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
        }
      }
    },
    "currentBrief": {"anyOf": [{"$ref": "#/definitions/projectPath"}, {"type": "null"}]},
    "currentPreview": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["filePath", "briefPath", "kind", "fromSec", "toSec", "width", "height", "fps", "generatedAt", "sha256"],
          "properties": {
            "filePath": {"$ref": "#/definitions/projectPath"},
            "briefPath": {"$ref": "#/definitions/projectPath"},
            "kind": {"enum": ["full", "excerpt"]},
            "fromSec": {"type": "number", "minimum": 0},
            "toSec": {"type": "number", "exclusiveMinimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "fps": {"type": "number", "exclusiveMinimum": 0},
            "generatedAt": {"type": "string", "minLength": 1},
            "briefSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
            "sourceSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        {"type": "null"}
      ]
    },
    "renders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "label", "dir", "briefPath", "status"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "dir": {"$ref": "#/definitions/projectPath"},
          "briefPath": {"anyOf": [{"$ref": "#/definitions/projectPath"}, {"type": "null"}]},
          "status": {"enum": ["started", "complete", "failed"]}
        }
      }
    },
    "latestRender": {"anyOf": [{"$ref": "#/definitions/projectPath"}, {"type": "null"}]},
    "final": {"$ref": "#/definitions/projectPath"}
  },
  "definitions": {
    "projectPath": {"type": "string", "minLength": 1}
  }
}
