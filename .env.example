# AutoMontage-Agent выполняет основной монтаж локально. Для Whisper, Review, preview,
# approval, render, FFmpeg, Remotion и Tesseract API-ключи не нужны.
# Скопируйте этот файл в .env и заполняйте только нужные строки. Файл .env не коммитьте.

# Legacy/developer provider scripts. Стандартный reel-turnkey их не использует.
# Anthropic и OpenAI могут быть платными: запускайте их только как отдельный явный opt-in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ElevenLabs - необязательная озвучка motion-ролика через отдельный платный API.
# Запрос разрешён только с --script --voice elevenlabs --accept-provider-cost.
# Voice ID - приватная настройка; в репозитории нет реального/default голоса.
# Существующая MP3/WAV/M4A-озвучка, preview и render работают без этих значений.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Локальная папка приватных тем вида <theme-id>/theme.json. Это не сетевой сервис.
THEMES_EXT=

# Локальная папка bin полной сборки ffmpeg/ffprobe. Укажите её, если системная сборка
# не содержит libwebp/libx264/libvpx/libopus/AAC или сломана после обновления.
AUTOMONTAGE_FFMPEG_DIR=

# Internal test hooks: they are set by the test runner and require no user value.
AUTOMONTAGE_BUILD_CAPTURE=
AUTOMONTAGE_LESSON_CAPTURE=
AUTOMONTAGE_LESSON_FAIL_RENDER=

# Internal Review-to-preview snapshot guards; set by the local server, not by users.
AUTOMONTAGE_PREVIEW_MANIFEST_HASH=
AUTOMONTAGE_PREVIEW_BRIEF_HASH=

# Pexels - единственный подключённый интернет-поиск B-roll в версии 1.6.0.
# Бесплатный ключ: https://www.pexels.com/api/
# Ключ читает только локальный Review server; браузер и Remotion его не получают.
# Без ключа ручной импорт и весь основной монтаж продолжают работать.
BROLL_SEARCH_PROVIDER=pexels
PEXELS_API_KEY=

# Зарезервировано для будущих провайдеров. В версии 1.6.0 не используется,
# поэтому оставьте строки пустыми.
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Сервисы и инструменты без переменных в этом файле:
# - Claude Code/Codex: используется текущая подписанная сессия, отдельного API-ключа нет.
# - faster-whisper: работает локально; при первом запуске модель может скачаться из Hugging Face.
# - FFmpeg/FFprobe, Remotion, Tesseract OCR и Playwright: локальные программы.
