projects/

# локальные результаты проверки навыков; канонические evals хранятся в skills/<name>/evals/
skills/*-workspace/

# исходное сырьё пользователя (свой ролик кладут сами, в репозиторий не коммитим)
public/source*.mp4
public/.automontage/
public/source-music.*
public/broll/avatar_photo.jpg

# аудио: музыку не распространяем (лицензии/вес). Генератор бита – в scripts/
assets/music/*.wav
assets/music/*.mp3

# сгенерированные артефакты пайплайна
props/placement_*.json
scripts/*_frame.jpg

# локальные артефакты Playwright/browser acceptance
test-results/
playwright-report/

# системное
.DS_Store
Thumbs.db

# тестовые исходники эфиров (личные, не в паблик)
